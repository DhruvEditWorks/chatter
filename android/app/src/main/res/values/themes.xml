<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework-only theme (no AppCompat dependency needed). -->
    <style name="Theme.Chatter" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <!-- Dark icons on the light system bars (ignored on old platforms). -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/chatter_accent</item>
    </style>
</resources>
